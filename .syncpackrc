{
  "lintSemverRanges": false,
  "lintFormatting": false,
  "semverGroups": [],
  "versionGroups": [
    {
      "dependencies": ["@types/**", "@testing-library/**", "typescript"],
      "dependencyTypes": ["prod"],
      "isBanned": true,
      "label": "These packages should only be under devDependencies."
    },
    {
      "dependencies": ["@refinedev/**", "@athenagroup/**"],
      "packages": ["**"],
      "isIgnored": true,
      "label": "@refinedev/@athenagroup dependencies are managed by changeset."
    },
    {
      "dependencies": ["**"],
      "dependencyTypes": ["peer"],
      "packages": ["**"],
      "isIgnored": true
    },
    {
      "dependencies": ["nock"],
      "dependencyTypes": ["dev"],
      "packages": [
        "@athenagroup/refine-appwrite",
        "@athenagroup/refine-graphql",
        "@athenagroup/refine-nestjsx-crud",
        "@athenagroup/refine-rest",
        "@athenagroup/refine-supabase"
      ],
      "isIgnored": true
    },
    {
      "dependencies": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "packages": ["with-nextjs-headless"],
      "isIgnored": true
    },
    {
      "dependencies": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "eslint",
        "postcss",
        "tailwindcss",
        "recharts",
        "clsx",
        "@netlify/plugin-nextjs"
      ],
      "packages": ["@athenagroup/refine-refine-ui"],
      "isIgnored": true
    }
  ]
}
